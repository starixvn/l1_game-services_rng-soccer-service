{
    "name": "dragon-tiger-fight-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/dragon-tiger-fight-service.git"
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "dev-test": "jest",
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "jest --testPathPattern=tests/integration-tests",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "chance": "^1.1.7",
        "d3-array": "^3.2.0",
        "lodash": "^4.17.19",
        "nodemon": "^2.0.4",
        "random": "^3.0.6",
        "random-js": "^2.1.0",
        "sc-game-base": "4.0.1",
        "sc-rebet-mode": "1.0.3"
    },
    "resolutions": {
        "sc-game-base": "4.0.1",
        "sc-base-apis": "1.18.2",
        "mongoose": "5.13.20"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^19.0.0",
        "@types/jest": "^26.0.20",
        "babel-jest": "^26.6.3",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^26.6.3",
        "jest-extended": "^0.11.5",
        "jest-junit": "^12.2.0",
        "jest-micro-auto-stub": "^1.0.6",
        "jest-sonar-reporter": "^2.0.0",
        "sc-game-service-integration-utils": "1.3.4-beta.1"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "jest": {
        "testResultsProcessor": "jest-junit"
    }
}
